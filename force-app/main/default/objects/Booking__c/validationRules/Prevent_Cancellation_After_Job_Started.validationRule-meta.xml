<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Cancellation_After_Job_Started</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 ISPICKVAL(Status__c,&quot;Cancelled&quot;),
 OR(
   PRIORVALUE(Status__c)=&quot;In Progress&quot;,
   PRIORVALUE(Status__c)=&quot;Completed&quot;
 )
)</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>Cannot Cancel After Job Started</errorMessage>
</ValidationRule>
