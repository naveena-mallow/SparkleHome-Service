<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Paid_Needs_Mode</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Payment_Status__c, &quot;Paid&quot;), ISBLANK(TEXT(Payment_Mode__c)))</errorConditionFormula>
    <errorDisplayField>Payment_Mode__c</errorDisplayField>
    <errorMessage>Choose Cash or UPI when a job is marked Paid.</errorMessage>
</ValidationRule>
