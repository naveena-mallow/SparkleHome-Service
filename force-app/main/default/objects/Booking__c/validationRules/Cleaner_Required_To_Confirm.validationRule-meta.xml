<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cleaner_Required_To_Confirm</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(ISPICKVAL(Status__c, &quot;Confirmed&quot;), ISPICKVAL(Status__c, &quot;In Progress&quot;),
 ISPICKVAL(Status__c, &quot;Completed&quot;)), ISBLANK(Cleaner__c))</errorConditionFormula>
    <errorDisplayField>Cleaner__c</errorDisplayField>
    <errorMessage>A booking cannot be Confirmed without a cleaner.</errorMessage>
</ValidationRule>
